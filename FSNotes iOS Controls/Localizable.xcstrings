    "See how many notes are in your Inbox and how many have been there for at least a week." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistěte, kolik poznámek máte v příchozích a kolik z nich tam je alespoň týden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wie viele Notizen im Eingang liegen und wie viele davon schon mindestens eine Woche dort sind."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ببینید چند یادداشت در صندوق ورودی دارید و چند مورد دست‌کم یک هفته در آن مانده‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez combien de notes se trouvent dans votre boîte de réception et combien y sont depuis au moins une semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि इनबॉक्स में कितने नोट हैं और उनमें से कितने कम से कम एक हफ़्ते से वहाँ हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla quante note sono in Entrata e quante ci sono da almeno una settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未整理のノート数と、そのうち1週間以上経過したノート数を表示します。"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk hoeveel notities in Postvak In staan en hoeveel er al minstens een week staan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quantas notas estão na caixa de entrada e quantas lá estão há pelo menos uma semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите, сколько заметок во входящих и сколько из них лежат там не меньше недели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelen Kutusu’nda kaç not olduğunu ve kaçının en az bir haftadır orada beklediğini görün."
