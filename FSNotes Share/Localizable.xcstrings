    "Couldn’t save this item. Check that it’s accessible and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save this item. Check that it’s accessible and try again."
          }
        },
        "ar-IQ": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ هذا العنصر. تأكد من إمكانية الوصول إليه وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto položku se nepodařilo uložit. Ověřte, že je dostupná, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt konnte nicht gesichert werden. Prüfe, ob es zugänglich ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar este elemento. Comprueba que sea accesible e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد ذخیره نشد. بررسی کنید که در دسترس باشد و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer cet élément. Vérifiez qu’il est accessible, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור פריט זה. יש לוודא שהוא נגיש ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम सहेजा नहीं जा सका। जाँचें कि यह उपलब्ध है और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questo elemento. Verifica che sia accessibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を保存できませんでした。アクセスできることを確認して、やり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목을 저장할 수 없습니다. 접근할 수 있는지 확인한 후 다시 시도하세요."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit onderdeel kon niet worden bewaard. Controleer of het toegankelijk is en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar este item. Verifique se ele está acessível e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar este elemento. Verifique se está acessível e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Проверьте доступность содержимого и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe kaydedilemedi. Erişilebilir olduğunu kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти. Перевірте доступність вмісту та спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此项目。请检查其是否可访问，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存此項目。請確認可以存取後再試一次。"
          }
        }
      }
    },
