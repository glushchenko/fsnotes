    "Save a page or selected text to Inbox.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a page or selected text to Inbox."
          }
        },
        "ar-IQ": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ صفحة أو نصًا محددًا في الوارد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte stránku nebo vybraný text do složky Příchozí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite oder ausgewählten Text im Posteingang sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una página o el texto seleccionado en Entrada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک صفحه یا متن انتخاب‌شده را در صندوق ورودی ذخیره کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une page ou le texte sélectionné dans la boîte de réception."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת עמוד או טקסט נבחר בתיבת דואר נכנס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज या चुने हुए टेक्स्ट को इनबॉक्स में सहेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una pagina o il testo selezionato nella cartella In Entrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページまたは選択したテキストを「未整理」に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 또는 선택한 텍스트를 Inbox에 저장합니다."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een pagina of geselecteerde tekst in Postvak In."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma página ou o texto selecionado no Inbox."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde uma página ou o texto selecionado na Caixa de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить страницу или выделенный текст во «Входящие»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sayfayı veya seçili metni Gelen kutusuna kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть сторінку або виділений текст у «Вхідні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将页面或所选文本保存到收集箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將網頁或所選文字儲存至收件匣。"
          }
        }
      }
    },
